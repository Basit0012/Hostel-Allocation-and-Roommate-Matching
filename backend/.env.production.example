# ==============================================================================
# RENDER PRODUCTION ENVIRONMENT VARIABLES
# Configure these in: Render Dashboard -> Environment -> Environment Variables
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
SECRET_KEY=generate-a-secure-50-character-secret-key-or-use-render-generator

# Database: Supabase PostgreSQL
# Recommended: Use Supabase Transaction Pooler (Port 6543)
# Example: postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Host & Domains
# Add your custom domains or Render service external URL (e.g. hostel-api.onrender.com)
DJANGO_ALLOWED_HOSTS=hostel-allocation-api.onrender.com

# Frontend Integration (Vercel)
# Set to your production Vercel frontend URL (HTTPS, no trailing slash)
FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-APP.vercel.app

# SSL Security (Render handles SSL termination at the edge)
SECURE_SSL_REDIRECT=True
