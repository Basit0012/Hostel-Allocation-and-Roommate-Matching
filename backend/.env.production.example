# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES (RAILWAY / RENDER)
# Configure these in: Railway Dashboard -> Service -> Variables
# ==============================================================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
SECRET_KEY=generate-a-secure-50-character-random-secret-key

# Database: Supabase PostgreSQL
# Recommended for runtime: Supabase Transaction Pooler (Port 6543) with SSL
# Remember to URL-encode special characters in password (e.g. @ -> %40, / -> %2F)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Host & Domains
# Railway automatically injects RAILWAY_PUBLIC_DOMAIN and permits *.up.railway.app.
# Add any custom domain here if using one:
ALLOWED_HOSTS=.up.railway.app

# Frontend Integration (Vercel)
# Set to your production Vercel frontend URL (HTTPS, no trailing slash)
FRONTEND_URL=https://YOUR-APP.vercel.app
CORS_ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-APP.vercel.app

# SSL Security (Railway & Render terminate SSL at edge proxy)
SECURE_SSL_REDIRECT=True

