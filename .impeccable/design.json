{
  "schemaVersion": 2,
  "name": "LPU Campus Residence Portal",
  "direction": "Watermelon UI — neutral crisp surfaces, collapsible workspace sidebar, Command-K search, spring micro-interactions",
  "mode": ["light", "dark"],
  "colors": {
    "light": {
      "background": "#FFFFFF",
      "surface": "#FAFAFA",
      "muted": "#F4F4F5",
      "foreground": "#09090B",
      "mutedForeground": "#52525B",
      "primary": "#18181B",
      "primaryForeground": "#FAFAFA",
      "accent": "#84CC16",
      "accentInk": "#09090B",
      "accentText": "#3F6212",
      "border": "#E4E4E7",
      "destructive": "#B91C1C",
      "warning": "#92400E"
    },
    "dark": {
      "background": "#09090B",
      "surface": "#111113",
      "muted": "#18181B",
      "foreground": "#FAFAFA",
      "mutedForeground": "#A1A1AA",
      "primary": "#FAFAFA",
      "primaryForeground": "#09090B",
      "accent": "#84CC16",
      "accentInk": "#09090B",
      "accentText": "#A3E635",
      "border": "#27272A",
      "destructive": "#FCA5A5",
      "warning": "#FCD34D"
    }
  },
  "typography": {
    "sans": "Schibsted Grotesk",
    "mono": "JetBrains Mono",
    "selfHosted": true
  },
  "geometry": {
    "shell": "16px",
    "card": "12px",
    "control": "8px",
    "pill": "9999px"
  },
  "patterns": [
    "CollapsibleSidebarShell",
    "CommandSearch",
    "ContinuousTabs",
    "CardSplitAccordion",
    "StepIndicatorStageRail",
    "InlineTableControl"
  ],
  "domainGuardrails": {
    "noV1Locking": true,
    "feeConfirmedState": "Not tracked yet",
    "roommateFactorsShown": "aggregate-score-and-room-alignment-only",
    "policyVerificationStatus": "unverified, confirm with warden/DSA"
  }
}
